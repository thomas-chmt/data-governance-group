    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Transformer le texte sur les cellules de la colonne signup_date à laide de lexpression grel:if(isNotNull(value.match(/\\d{2}\\/\\d{2}\\/\\d{4}/)), with(value.split('/'), p, p[2]+'-'+p[1]+'-'+p[0]),\nif(isNotNull(value.match(/\\d{2}-\\d{2}-\\d{4}/)), with(value.split('-'), p, p[2]+'-'+p[0]+'-'+p[1]),\nif(isNotNull(value.match(/\\d{4}\\/\\d{2}\\/\\d{2}/)), value.replace('/', '-'), value)))"
  },
